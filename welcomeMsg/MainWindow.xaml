<Window x:Class="welcomeMsg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:welcomeMsg"
        mc:Ignorable="d"
        Title="Welcome" Height="400" Width="500">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TabControl Height="329" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="TabItem" RenderTransformOrigin="0.5,0.5">
                <TabItem.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-68.503"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TabItem.RenderTransform>
                <Grid Background="white" RenderTransformOrigin="0.5,0.5" >
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="178.627"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="307*"/>
                        <ColumnDefinition Width="145*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Enter your name:" Width="197" Margin="10,0,100,0"/>
                    <TextBox x:Name="txtName" Margin="10,28,109,252"/>
                    <Button Content="Greet" Click="Button_Click" Width="80" Margin="207,26,20,249" Background="#FF5F0B0B" BorderThickness="10,1,40,1" BorderBrush="#FF3F419A" FontFamily="Trebuchet MS" FontSize="22"/>
                    <TextBlock x:Name="txtWelcome" Margin="226,15,0,0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <Slider HorizontalAlignment="Left" Margin="216,123,0,0" VerticalAlignment="Top" Width="241" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Height="58">
                        <Slider.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="0.724" ScaleY="0.996"/>
                                <SkewTransform AngleX="72.28" AngleY="-7.044"/>
                                <RotateTransform Angle="-7.179"/>
                                <TranslateTransform X="-117.889" Y="33.637"/>
                            </TransformGroup>
                        </Slider.RenderTransform>
                    </Slider>
                    <StatusBar Grid.Column="1" Margin="0,142,0,0">
                        <StatusBar/>
                    </StatusBar>


                </Grid>
            </TabItem>
            <TabItem Header="TabItem" RenderTransformOrigin="0.5,0.5">
                <TabItem.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="119.364"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TabItem.RenderTransform>
                <MediaElement Margin="36,6,316,193"/>
            </TabItem>
            <MediaElement Height="100" Width="100"/>
        </TabControl>
    </StackPanel>
</Window>
